# =============================================================================
# .gitignore — Bengaluru Home Price Prediction System
# =============================================================================

# Secrets & environment
.env
.env.*
!.env.example
*.pem
*.key

# Trained model artefacts (stored in S3 — never commit to git)
*.pkl
*.pickle
server/model/*.pkl
server/model/*.json
model_training/*.pkl

# Raw CSV datasets
model_training/*.csv
model_training/data/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.eggs/

# Python virtual environments
.venv/
venv/
env/

# Node.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.next/

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.code-workspace

# Test & coverage reports
htmlcov/
.coverage
coverage.xml
reports/

# Terraform local state & credentials
.terraform/
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.auto.tfvars
*.tfvars
terraform/.terraform.lock.hcl
terraform/terraform.lock.hcl
terraform/terraform-iam-policy.json

# Local database
server/data/*.sqlite3
data/*.sqlite3
